# 운영 배포용 환경변수 템플릿. 복사해서 값을 채운다.
#   cp deploy/production.env.example deploy/.env && chmod 600 deploy/.env
# 각 변수의 의미는 docs/guide/configuration.md를 본다.
# deploy/.env는 .gitignore에 들어 있다. 비밀값이 담기므로 커밋하지 않는다.

# 이미지: 로컬에서 빌드했다면 IMAGE=ssl-checker, APP_VERSION=빌드할 때 붙인 태그
IMAGE=ssl-checker
APP_VERSION=1.0.0

# api를 열 호스트 IP와 포트. 클라이언트 서버들만 닿는 내부 인터페이스 주소를 넣는다.
BIND_ADDR=10.0.0.5
API_PORT=8080

# 앞단 리버스 프록시 주소만 넣는다. 프록시가 없으면 비워 둔다.
TRUSTED_PROXIES=

# DNS 공급자와 챌린지 전용 존
DNS_PROVIDER=cloudflare
CHALLENGE_ZONE=acme-chk.example
CF_ZONE_ID=
TXT_TTL=60

# 3단계 모니터링용(현재 미사용)
CHECK_INTERVAL=6h

# 비밀값
# openssl rand -hex 32
ADMIN_KEY=
# Cloudflare: 전용 존의 Zone > DNS > Edit 권한만 가진 토큰
CF_API_TOKEN=
# openssl rand -hex 24  (DATABASE_URL에 그대로 들어가므로 URL에 안전한 값)
POSTGRES_PASSWORD=
