# 운영 배포용 환경변수 템플릿. 복사해서 값을 채운다.
#   cp deploy/production.env.example deploy/.env && chmod 600 deploy/.env
# 각 변수의 의미는 docs/guide/configuration.md를 본다.
# deploy/.env는 .gitignore에 들어 있다. 비밀값이 담기므로 커밋하지 않는다.
# 이미지는 compose가 저장소의 Dockerfile로 직접 빌드하므로 이미지 관련 변수는 없다.

# api를 여는 방법에 따라 한쪽만 채운다.
# (1) compose.caddy.yaml: Caddy 컨테이너가 붙어 있는 Docker 네트워크 이름
CADDY_NETWORK=caddy
# (2) compose.ports.yaml: api를 열 호스트 IP와 포트. 클라이언트 서버들만 닿는 내부 인터페이스 주소
BIND_ADDR=
API_PORT=8080

# 앞단 리버스 프록시(Caddy 등)의 주소만 넣는다. 프록시가 없으면 비워 둔다.
TRUSTED_PROXIES=

# 클라이언트가 api에 닿는 외부 주소. 화면·자격 증명 안내에 쓴다. 비우면 요청에서 만든다.
# 예: https://ssl-checker.example.com
PUBLIC_URL=

# 선택. 인증서 점검·CNAME 확인 주기(최소 5m)와 CNAME 확인에 쓸 공개 리졸버
CHECK_INTERVAL=6h
DNS_RESOLVER=1.1.1.1:53

# DNS 공급자와 챌린지 TXT를 둘 이름
DNS_PROVIDER=cloudflare
CHALLENGE_ZONE=acme.example.com
# CHALLENGE_ZONE이 Cloudflare 존 이름과 다르면(하위 이름을 쓰면) 필수
CF_ZONE_ID=

# 비밀값
# openssl rand -hex 32
ADMIN_KEY=
# Cloudflare: 챌린지 TXT를 둘 존의 Zone > DNS > Edit 권한만 가진 토큰
CF_API_TOKEN=
# openssl rand -hex 24  (DATABASE_URL에 그대로 들어가므로 URL에 안전한 값)
POSTGRES_PASSWORD=
