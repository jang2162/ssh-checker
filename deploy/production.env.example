# Environment template for production. Copy it and fill in the values.
#   cp deploy/production.env.example deploy/.env && chmod 600 deploy/.env
# See docs/guide/configuration.md for what each variable means.
# deploy/.env is in .gitignore. It holds secrets, so never commit it.
# compose builds the image from the repository Dockerfile, so there are no image variables.

# Fill in only the one that matches how you expose the api.
# (1) compose.caddy.yaml: name of the Docker network the Caddy container is on
CADDY_NETWORK=caddy
# (2) compose.ports.yaml: host IP and port to publish the api on (an internal interface only the client servers can reach)
BIND_ADDR=
API_PORT=8080

# Only the address of the front reverse proxy (Caddy etc.). Leave empty when there is no proxy.
TRUSTED_PROXIES=

# The external address clients use to reach the api. Used in the dashboard and credentials guidance.
# When empty it is derived from the request. Example: https://ssl-checker.example.com
PUBLIC_URL=

# Language of the dashboard, setup.sh, llms.txt and status code descriptions: en (default) or ko
UI_LANGUAGE=en

# Optional. Interval of certificate and CNAME checks (minimum 5m), and the public resolver used for CNAME checks
CHECK_INTERVAL=6h
DNS_RESOLVER=1.1.1.1:53

# DNS provider and the name to place challenge TXT records under
DNS_PROVIDER=cloudflare
CHALLENGE_ZONE=acme.example.com
# Required when CHALLENGE_ZONE differs from the Cloudflare zone name (i.e. you use a sub-name)
CF_ZONE_ID=

# Secrets
# openssl rand -hex 32
ADMIN_KEY=
# Cloudflare: a token with only Zone > DNS > Edit on the zone that holds the challenge TXT records
CF_API_TOKEN=
# openssl rand -hex 24  (goes into DATABASE_URL as is, so use a URL-safe value)
POSTGRES_PASSWORD=
